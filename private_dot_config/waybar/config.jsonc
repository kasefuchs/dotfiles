      "clock",
      "group/power"
    ]
  },
  {
    "include": ["modules.jsonc"],
    "output": ["!eDP-1", "*"],
    "modules-right": [
      "tray",
      "idle_inhibitor",
      "power-profiles-daemon",
      "pulseaudio#input",
      "pulseaudio#output",
      "temperature",
      "niri/language",
      "battery",
      "clock",
      "group/power"
    ]
  }
]
